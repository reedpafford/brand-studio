# DOMAIN comes from deploy/.env. Caddy gets and renews the HTTPS certificate itself.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# The API lives under /api; the prefix is removed before it reaches the server.
	# While a deploy restarts the API, requests wait (up to 30 s) instead of failing.
	handle_path /api/* {
		reverse_proxy api:8000 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	# /health is the API's real health check (not the web page), for monitoring.
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Brand Studio Next (the test site, branch `next`): the same address on port 8443, and its own
# name on 443 (Reed's domain; cloud sessions only reach 443). Its own stack (deploy/next/) answers
# on the shared edge network; if it's down, only these addresses fail. Until the name's DNS points
# here, Caddy keeps retrying its certificate in the background; live's address is unaffected.
{$DOMAIN}:8443, thisisatestingenv.online {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# Live's sign-in cookie never reaches the test site's code (cookies ignore ports).
	reverse_proxy brand-studio-next-web:80 {
		header_up Cookie "(^|;\s*)bs_session=[^;]*" ""
	}
}

# Plain http always goes to the live site on 443 (stated, so the port-8443 site can't take it),
# with the same 308 Caddy's own redirect sends.
http://{$DOMAIN} {
	redir https://{host}{uri} 308
}
