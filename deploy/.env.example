# Copy to deploy/.env on the server and fill in. Placeholders only: never commit the real file.

# The web address people open, e.g. studio.example.com. Its DNS must point at this server.
DOMAIN=studio.example.com

# Database password. Letters and numbers only (it goes inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# One-time code for creating the first owner account. Long and random: openssl rand -hex 32
# Delete this line after setup and run: docker compose up -d
BS_SETUP_TOKEN=change-me

# Paid generation (Replicate, Claude). Leave false until Reed decides to switch it on.
BS_GENERATION_ENABLED=false

# Provider keys. Only used when generation is on. Never share these.
REPLICATE_API_TOKEN=
STUDIO_ANTHROPIC_KEY=

# Set by docker-compose.yml, so they are not read from here:
#   BS_ENV=production  BS_DATABASE_URL=postgresql+psycopg://...@db/brand
#   BS_STORAGE_DIR=/data/storage  BS_COOKIE_SECURE=true

# Optional tuning (defaults shown):
# BS_SESSION_DAYS=30
# BS_INVITE_DAYS=7
# BS_MAX_UPLOAD_MB=200
# BS_MAX_DOWNLOAD_MB=500
# BS_LOGIN_MAX_FAILURES=5
# BS_LOGIN_MAX_FAILURES_PER_IP=20
# BS_LOGIN_WINDOW_MINUTES=15
# BS_WORKER_POLL_SECONDS=2
